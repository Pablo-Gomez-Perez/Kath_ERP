<jasperReport name="ReporteVentasTotales"
        language="java"
        pageWidth="612"
        pageHeight="792"
        columnWidth="540"
        leftMargin="36"
        rightMargin="36"
        topMargin="36"
        bottomMargin="36"
        uuid="83de5538-6ce1-4fd5-91a9-a846a4037504">

    <property name="net.sf.jasperreports.export.pdf.metadata.title" value="Reporte de ventas totales"/>

    <style name="Base" default="true" fontName="SansSerif" fontSize="9.0"/>

    <parameter name="FECHA_INICIO" class="java.lang.String"/>
    <parameter name="FECHA_FIN" class="java.lang.String"/>
    <parameter name="VENTAS_TOTALES" class="java.lang.String"/>
    <parameter name="IVA_COBRADO" class="java.lang.String"/>

    <field name="fecha" class="java.lang.String"/>
    <field name="numeroVentas" class="java.lang.Long"/>
    <field name="subtotal" class="java.lang.String"/>
    <field name="iva" class="java.lang.String"/>
    <field name="total" class="java.lang.String"/>

    <title height="82">
        <element kind="staticText"
                x="0"
                y="0"
                width="540"
                height="30"
                bold="true"
                fontSize="18.0"
                hTextAlign="Center"
                vTextAlign="Middle">
            <text><![CDATA[REPORTE DE VENTAS TOTALES]]></text>
        </element>

        <element kind="staticText"
                x="0"
                y="34"
                width="540"
                height="16"
                bold="true"
                fontSize="10.0"
                hTextAlign="Center">
            <text><![CDATA[Intervalo de fechas]]></text>
        </element>

        <element kind="textField"
                x="0"
                y="52"
                width="540"
                height="18"
                fontSize="10.0"
                hTextAlign="Center">
            <expression><![CDATA["Del " + $P{FECHA_INICIO} + " al " + $P{FECHA_FIN}]]></expression>
        </element>
    </title>

    <columnHeader height="32">
        <element kind="staticText" x="0" y="0" width="100" height="26"
                mode="Opaque" backcolor="#E6E6E6" bold="true"
                hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Fecha]]></text>
        </element>
        <element kind="staticText" x="100" y="0" width="100" height="26"
                mode="Opaque" backcolor="#E6E6E6" bold="true"
                hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Número de ventas]]></text>
        </element>
        <element kind="staticText" x="200" y="0" width="110" height="26"
                mode="Opaque" backcolor="#E6E6E6" bold="true"
                hTextAlign="Right" vTextAlign="Middle">
            <text><![CDATA[Sub total]]></text>
        </element>
        <element kind="staticText" x="310" y="0" width="100" height="26"
                mode="Opaque" backcolor="#E6E6E6" bold="true"
                hTextAlign="Right" vTextAlign="Middle">
            <text><![CDATA[IVA]]></text>
        </element>
        <element kind="staticText" x="410" y="0" width="130" height="26"
                mode="Opaque" backcolor="#E6E6E6" bold="true"
                hTextAlign="Right" vTextAlign="Middle">
            <text><![CDATA[Total]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24" splitType="Prevent">
            <element kind="textField"
                    x="0"
                    y="2"
                    width="100"
                    height="18"
                    hTextAlign="Center"
                    vTextAlign="Middle">
                <expression><![CDATA[$F{fecha}]]></expression>
            </element>

            <element kind="textField"
                    x="100"
                    y="2"
                    width="100"
                    height="18"
                    hTextAlign="Center"
                    vTextAlign="Middle">
                <expression><![CDATA[$F{numeroVentas}]]></expression>
            </element>

            <element kind="textField"
                    x="200"
                    y="2"
                    width="110"
                    height="18"
                    hTextAlign="Right"
                    vTextAlign="Middle">
                <expression><![CDATA[$F{subtotal}]]></expression>
            </element>

            <element kind="textField"
                    x="310"
                    y="2"
                    width="100"
                    height="18"
                    hTextAlign="Right"
                    vTextAlign="Middle">
                <expression><![CDATA[$F{iva}]]></expression>
            </element>

            <element kind="textField"
                    x="410"
                    y="2"
                    width="130"
                    height="18"
                    bold="true"
                    hTextAlign="Right"
                    vTextAlign="Middle">
                <expression><![CDATA[$F{total}]]></expression>
            </element>
        </band>
    </detail>

    <summary height="78">
        <element kind="staticText"
                x="300"
                y="14"
                width="120"
                height="20"
                bold="true"
                hTextAlign="Right"
                vTextAlign="Middle">
            <text><![CDATA[Ventas Totales:]]></text>
        </element>

        <element kind="textField"
                x="420"
                y="14"
                width="120"
                height="20"
                bold="true"
                hTextAlign="Right"
                vTextAlign="Middle">
            <expression><![CDATA[$P{VENTAS_TOTALES}]]></expression>
        </element>

        <element kind="staticText"
                x="300"
                y="38"
                width="120"
                height="20"
                bold="true"
                hTextAlign="Right"
                vTextAlign="Middle">
            <text><![CDATA[I.V.A cobrado:]]></text>
        </element>

        <element kind="textField"
                x="420"
                y="38"
                width="120"
                height="20"
                bold="true"
                hTextAlign="Right"
                vTextAlign="Middle">
            <expression><![CDATA[$P{IVA_COBRADO}]]></expression>
        </element>
    </summary>

    <pageFooter height="18">
        <element kind="textField"
                x="0"
                y="2"
                width="540"
                height="14"
                fontSize="8.0"
                hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

</jasperReport>
